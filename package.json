{
  "name": "ruta-visitas",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Planificador mensual de visitas a tiendas con arquitectura medallón (bronce → plata → oro)",
  "scripts": {
    "pipeline": "tsx pipeline/run.ts",
    "dev": "npm run pipeline && vite",
    "build": "npm run pipeline && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "engines": { "node": ">=20" }
}
